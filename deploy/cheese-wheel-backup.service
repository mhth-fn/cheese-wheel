[Unit]
Description=Verified Cheese Wheel SQLite backup
Documentation=file:/opt/cheese-wheel/deploy/README-backups.md
ConditionPathExists=/var/lib/cheese-wheel/cheese_wheel.db
After=local-fs.target
OnSuccess=cheese-wheel-offsite-backup.service
OnFailure=cheese-wheel-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=CHEESE_WHEEL_DB=/var/lib/cheese-wheel/cheese_wheel.db
Environment=CHEESE_WHEEL_UPLOADS=/var/lib/cheese-wheel/uploads
Environment=CHEESE_WHEEL_SIGAME_PACKS=/var/lib/cheese-wheel/sigame-packs
Environment=CHEESE_WHEEL_BACKUP_DIR=/var/backups/cheese-wheel
Environment=CHEESE_WHEEL_BACKUP_RETENTION_DAYS=3
ExecStart=/usr/bin/node /opt/cheese-wheel/scripts/backup.js
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
IPAddressDeny=any
ReadOnlyPaths=/var/lib/cheese-wheel
ReadWritePaths=/var/backups/cheese-wheel
