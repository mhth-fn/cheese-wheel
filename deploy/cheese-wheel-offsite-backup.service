[Unit]
Description=Encrypted off-site Cheese Wheel backup
Documentation=file:/opt/cheese-wheel/deploy/README-backups.md
ConditionPathExists=/etc/cheese-wheel/offsite.env
After=network-online.target
Wants=network-online.target
OnFailure=cheese-wheel-backup-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=CHEESE_WHEEL_BACKUP_DIR=/var/backups/cheese-wheel
Environment=RESTIC_BIN=/usr/bin/restic
Environment=RESTIC_CACHE_DIR=/var/cache/cheese-wheel-restic
EnvironmentFile=/etc/cheese-wheel/offsite.env
ExecStart=/usr/bin/node /opt/cheese-wheel/scripts/offsite-backup.js
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/backups/cheese-wheel
ReadOnlyPaths=/etc/cheese-wheel
ReadWritePaths=/var/cache/cheese-wheel-restic
