# Copy to /etc/cheese-wheel/offsite.env with mode 0600 and root ownership.
# restic encrypts every file before it leaves the server.
RESTIC_REPOSITORY=s3:https://s3.example.net/cheese-wheel
RESTIC_PASSWORD_FILE=/etc/cheese-wheel/restic-password

# Provider credentials depend on the selected restic backend. S3-compatible
# storage commonly uses these variables:
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Optional retention policy:
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
